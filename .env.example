# ==============================================================================
# StreamVault - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# --- Core WebUI Server Settings ---
VOD_HOST=0.0.0.0
VOD_PORT=8080
VOD_PUBLIC_BASE=http://localhost:8080
VOD_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-32-chars-minimum
VOD_SECURE_COOKIES=false

# --- Authentication & Initial Bootstrap ---
# NOTE: Required in production. Cannot be 'admin'/'admin'.
VOD_USER=vaultadmin
VOD_PASS=GenerateAStrongPasswordHere123!
VOD_ALLOW_ENV_LOGIN=false
VOD_SESSION_MAX_AGE_SEC=0
VOD_SESSION_COOKIE_MAX_AGE_SEC=34560000

# --- Storage Paths ---
# Base directory for recordings, metadata, and database
# Default: ./data (or the app directory)
# VOD_BASE_DIR=/var/lib/streamvault/data
# VOD_FILES_DIR=/var/lib/streamvault/data/files
# VOD_HLS_DIR=/var/lib/streamvault/data/.hls
# VOD_THUMB_DIR=/var/lib/streamvault/data/.thumbs
# VOD_META_DIR=/var/lib/streamvault/data/.meta

# Low-latency Live HLS RAM-Disk (Recommended on Linux: /dev/shm/streamvault_hls)
LIVE_HLS_DIR=/dev/shm/streamvault_hls

# --- Reverse Proxy Offloading (Nginx) ---
# When true, delegates video range requests to Nginx via X-Accel-Redirect (saves Python RAM/CPU)
VOD_USE_X_ACCEL=true

# --- Streamlink & Recorder Options ---
# Optional Twitch OAuth token to bypass ads / load subscriber qualities
# STREAM_RECORDER_TWITCH_OAUTH=
# LIVE_TWITCH_OAUTH=
# LIVE_TWITCH_ANONYMOUS=true

# Optional Twitch API Client (for metadata auto-sync and EventSub)
# TWITCH_CLIENT_ID=your_twitch_client_id_here
# TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# --- Performance & Caching ---
# Optional Redis cache for high-concurrency deployments
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Storage Health & Alerting ---
STORAGE_ALERT_THRESHOLD_PCT=90
STORAGE_ALERT_THRESHOLD_FREE_GB=25
STORAGE_ALERT_CHECK_INTERVAL_SEC=60
STORAGE_ALERT_COOLDOWN_SEC=21600
# Optional Discord webhook URL for automated disk space warnings
# STORAGE_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
