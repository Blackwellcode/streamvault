#!/usr/bin/env bash
# ==============================================================================
# StreamVault — Central Management CLI
# Registered globally at /usr/local/bin/streamvault
# ==============================================================================
set -euo pipefail

APP_DIR="${STREAMVAULT_DIR:-/opt/streamvault/app}"
VENV_DIR="${STREAMVAULT_VENV:-/opt/streamvault/venv}"
ENV_FILE="${STREAMVAULT_ENV:-/etc/streamvault/env}"
SERVICE_USER="${STREAMVAULT_USER:-streamvault}"

# Visual helpers
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

header() {
    echo -e "${CYAN}${BOLD}"
    echo "  ____  _                                    _ _   "
    echo " / ___|| |_ _ __ ___  __ _ _ __ _____   ____ _| | |_ "
    echo " \___ \| __| '__/ _ \/ _\` | '_ \` _ \ \ / / _\` | | __|"
    echo "  ___) | |_| | |  __/ (_| | | | | | \ V / (_| | | |_ "
    echo " |____/ \__|_|  \___|\__,_|_| |_| |_|\_/ \__,_|_|\__|"
    echo -e "              Stream Archival & Live Replay Engine${NC}\n"
}

usage() {
    header
    echo -e "${BOLD}Usage:${NC} streamvault [COMMAND] [OPTIONS]"
    echo ""
    echo -e "${BOLD}Service Management:${NC}"
    echo -e "  ${GREEN}start${NC}             Start WebUI, Recorder and Worker daemons"
    echo -e "  ${GREEN}stop${NC}              Stop all running daemons"
    echo -e "  ${GREEN}restart${NC}           Restart WebUI, Recorder and Worker daemons"
    echo -e "  ${GREEN}status${NC}            Display health, system load, and systemd status"
    echo -e "  ${GREEN}logs${NC} [service]    Follow live logs (webui, recorder, worker, or all)"
    echo ""
    echo -e "${BOLD}Operations:${NC}"
    echo -e "  ${GREEN}update${NC}            Pull latest Git commit, upgrade deps, and restart"
    echo -e "  ${GREEN}config${NC}            Inspect or edit active environment (/etc/streamvault/env)"
    echo -e "  ${GREEN}check${NC}             Validate Python syntax, Nginx, and database schemas"
    echo ""
    echo -e "${BOLD}Cloud Storage:${NC}"
    echo -e "  ${GREEN}storage${NC} [args]    Manage external storage (list, add, test, sync, ...)"
    echo -e "                        Example: streamvault storage add --type google_drive --name 'Drive'"
    echo ""
    exit 1
}

require_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}[ERROR] This command requires root privileges. Please use sudo.${NC}"
        exit 1
    fi
}

load_env() {
    if [[ -f "${ENV_FILE}" ]]; then
        set -a
        # shellcheck disable=SC1090
        source "${ENV_FILE}"
        set +a
    fi
}

cmd_start() {
    require_root
    echo -e "${BLUE}[*] Starting StreamVault daemons...${NC}"
    systemctl start streamvault-webui.service streamvault-recorder.service streamvault-worker.service
    echo -e "${GREEN}[OK] Services started successfully.${NC}"
}

cmd_stop() {
    require_root
    echo -e "${BLUE}[*] Stopping StreamVault daemons...${NC}"
    systemctl stop streamvault-worker.service streamvault-recorder.service streamvault-webui.service
    echo -e "${GREEN}[OK] Services stopped.${NC}"
}

cmd_restart() {
    require_root
    echo -e "${BLUE}[*] Restarting StreamVault daemons...${NC}"
    systemctl restart streamvault-webui.service streamvault-recorder.service streamvault-worker.service
    echo -e "${GREEN}[OK] Restart complete.${NC}"
}

cmd_status() {
    header
    echo -e "${BOLD}Daemons Status:${NC}"
    systemctl status streamvault-webui.service streamvault-recorder.service streamvault-worker.service --no-pager -l || true
    echo ""
    echo -e "${BOLD}Storage & RAM-Disk:${NC}"
    df -h /dev/shm | grep -v "udev" || true
    echo ""
}

cmd_logs() {
    local target="${1:-webui}"
    case "$target" in
        webui)
            journalctl -u streamvault-webui.service -f -n 50
            ;;
        recorder)
            journalctl -u streamvault-recorder.service -f -n 50
            ;;
        worker)
            journalctl -u streamvault-worker.service -f -n 50
            ;;
        all)
            journalctl -u streamvault-webui.service -u streamvault-recorder.service -u streamvault-worker.service -f -n 50
            ;;
        *)
            echo -e "${RED}[ERROR] Unknown service: $target (use webui, recorder, worker, or all)${NC}"
            exit 1
            ;;
    esac
}

cmd_update() {
    require_root
    echo -e "${BLUE}[*] Updating StreamVault from Git...${NC}"
    cd "${APP_DIR}"
    git pull --ff-only
    "${VENV_DIR}/bin/pip" install --upgrade -r requirements.txt
    systemctl restart streamvault-webui.service streamvault-recorder.service streamvault-worker.service
    echo -e "${GREEN}[OK] Update completed and daemons restarted.${NC}"
}

cmd_config() {
    if [[ -f "${ENV_FILE}" ]]; then
        ${EDITOR:-nano} "${ENV_FILE}"
    else
        echo -e "${RED}[ERROR] Config file ${ENV_FILE} not found.${NC}"
        exit 1
    fi
}

cmd_check() {
    load_env
    echo -e "${BLUE}[*] Validating StreamVault integrity...${NC}"
    cd "${APP_DIR}"
    "${VENV_DIR}/bin/python3" -m compileall -q core recorder WEBUI
    echo -e "${GREEN}[OK] Python syntax: valid.${NC}"
    if command -v nginx >/dev/null 2>&1; then
        nginx -t
        echo -e "${GREEN}[OK] Nginx configuration: valid.${NC}"
    fi
}

cmd_storage() {
    load_env
    cd "${APP_DIR}"
    # The WebUI/worker own the SQLite database. Running storage commands as
    # root can leave root-owned WAL files that the service user cannot write.
    if [[ $EUID -eq 0 ]] && id "${SERVICE_USER}" >/dev/null 2>&1; then
        if command -v runuser >/dev/null 2>&1; then
            runuser -u "${SERVICE_USER}" -- "${VENV_DIR}/bin/python3" -m core.storage.cli "$@"
        else
            sudo -u "${SERVICE_USER}" -- "${VENV_DIR}/bin/python3" -m core.storage.cli "$@"
        fi
    else
        "${VENV_DIR}/bin/python3" -m core.storage.cli "$@"
    fi
}

# Subcommand dispatch
case "${1:-}" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    status)
        cmd_status
        ;;
    logs)
        cmd_logs "${2:-webui}"
        ;;
    update)
        cmd_update
        ;;
    config)
        cmd_config
        ;;
    check)
        cmd_check
        ;;
    storage)
        shift
        cmd_storage "$@"
        ;;
    help|--help|-h|"")
        usage
        ;;
    *)
        echo -e "${RED}[ERROR] Unknown command: $1${NC}\n"
        usage
        ;;
esac
